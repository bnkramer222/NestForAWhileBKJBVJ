# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL (Render Postgres, Supabase, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/epic_cure
PGSSL=false

# Session signing key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-change-me

# AES-256-GCM key material for PHI columns (names, identifiers).
# In Render, use a generated secret. Changing it makes existing PHI unreadable.
PHI_KEY=dev-only-change-me-too

# Warehouse capacity gate
MAX_FLOOR_CAPACITY=25

# System of Intelligence endpoint (filled in later — must stay open-source/free)
# e.g. http://localhost:11434/api/chat (Ollama) or a free HF Space URL
AI_ENGINE_URL=
AI_ENGINE_MODEL=llama3.1:8b-instruct-q4_K_M
AI_TIMEOUT_MS=6000
