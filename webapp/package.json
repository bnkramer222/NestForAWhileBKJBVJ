{
  "name": "epic-cure-mtg",
  "version": "0.1.0",
  "private": true,
  "description": "Medically Tailored Groceries warehouse system for Epic Cure — MVC web app (Node/Express, PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:schema": "node src/scripts/run-sql.js db/schema.sql",
    "db:seed": "node src/scripts/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^7.2.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  }
}
