  </main>
  <footer class="foot">
    <p><%= brand.name %> <%= t('brand.by') %> <%= brand.org %> · <%= t('footer') %></p>
  </footer>
  <% if (typeof bodyClass !== 'undefined' && (bodyClass === 'shop' || bodyClass === 'checkout' || bodyClass === 'kiosk')) { %>
  <script src="/static/vendor/html5-qrcode.min.js" defer></script>
  <% } %>
  <script src="/static/js/app.js" defer></script>
</body>
</html>
