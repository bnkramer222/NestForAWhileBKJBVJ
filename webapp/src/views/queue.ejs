<%- include('partials/head') %>

<section class="hero">
  <p class="eyebrow">It's busy right now</p>
  <h1>You're in line, <%= clientName %>.</h1>
  <p class="lead">
    The market floor is full, so we're holding your place. No need to stand at the desk —
    keep this page open and it will take you straight to your shopping list when it's your turn.
  </p>
</section>

<section class="card card--elevated queue-card" id="queue-app" data-token="<%= refreshToken %>">
  <p class="muted small">Your place in line</p>
  <p class="queue-position"><span id="queue-pos"><%= position %></span></p>
  <p id="queue-ahead" class="muted">
    <% if (position <= 1) { %>You're next!<% } else { %><strong><%= position - 1 %></strong> <%= position - 1 === 1 ? 'household' : 'households' %> ahead of you<% } %>
  </p>
  <p class="muted small">
    <span class="live-dot" aria-hidden="true"></span>
    Updating live · <%= floor.active %> of <%= floor.max %> shoppers on the floor
  </p>
  <p id="queue-status" class="notice" role="status" hidden></p>
  <form method="post" action="/queue/leave">
    <input type="hidden" name="token" value="<%= refreshToken %>">
    <button type="submit" class="btn btn--ghost">Leave the line</button>
  </form>
</section>

<%# Fallback for browsers without JavaScript: reload every 30 seconds. %>
<meta http-equiv="refresh" content="30;url=/queue?token=<%= refreshToken %>">

<%- include('partials/foot') %>
