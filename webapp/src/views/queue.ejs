<%- include('partials/head') %>

<section class="hero">
  <p class="eyebrow"><%= t('queue.eyebrow') %></p>
  <h1><%= t('queue.h1', { name: clientName }) %></h1>
  <p class="lead"><%= t('queue.lead') %></p>
</section>

<section class="card card--elevated queue-card" id="queue-app" data-token="<%= refreshToken %>">
  <p class="muted small"><%= t('queue.place') %></p>
  <p class="queue-position"><span id="queue-pos"><%= position %></span></p>
  <p id="queue-ahead" class="muted">
    <%= position <= 1 ? t('queue.next') : (position - 1 === 1 ? t('queue.ahead.one') : t('queue.ahead.many', { n: position - 1 })) %>
  </p>
  <p class="muted small">
    <span class="live-dot" aria-hidden="true"></span>
    <%= t('queue.live', { active: floor.active, max: floor.max }) %>
  </p>
  <p id="queue-status" class="notice" role="status" hidden></p>
  <form method="post" action="/queue/leave">
    <input type="hidden" name="token" value="<%= refreshToken %>">
    <button type="submit" class="btn btn--ghost"><%= t('queue.leave') %></button>
  </form>
</section>

<%# Fallback for browsers without JavaScript: reload every 30 seconds. %>
<meta http-equiv="refresh" content="30;url=/queue?token=<%= refreshToken %>">

<%- include('partials/foot') %>
