<%- include('partials/head') %>

<section class="hero">
  <p class="eyebrow"><%= t('kiosk.eyebrow') %></p>
  <h1><%= t('kiosk.h1') %></h1>
  <p class="lead"><%= t('kiosk.lead') %></p>
</section>

<div class="grid grid--two">
  <section class="card card--elevated">
    <h2><%= t('kiosk.start') %></h2>
    <% if (error) { %>
      <div class="banner banner--error" role="alert"><%= error %></div>
    <% } %>
    <form method="post" action="/kiosk/check-in" class="stack">
      <label for="token"><%= t('kiosk.codeLabel') %></label>
      <input id="token" name="token" type="text" inputmode="text" autocomplete="off"
             placeholder="MTG-1001" autocapitalize="characters" value="<%= typeof prefillCode !== 'undefined' ? prefillCode : '' %>" required>
      <button type="submit" class="btn btn--primary btn--lg"><%= t('kiosk.checkIn') %></button>
    </form>
    <button type="button" id="kiosk-camera-btn" class="btn btn--ghost btn--block"><%= t('kiosk.scanCard') %></button>
    <div id="kiosk-camera" class="camera" hidden></div>

    <p class="small"><%= t('kiosk.firstTime') %> <a href="/enroll"><%= t('kiosk.signupLink') %></a> — <%= t('kiosk.noId') %></p>
  </section>

  <section class="card">
    <h2><%= t('kiosk.how') %></h2>
    <ol class="steps">
      <li><%- t('kiosk.step1') %></li>
      <li><%- t('kiosk.step2') %></li>
      <li><%- t('kiosk.step3') %></li>
      <li><%- t('kiosk.step4') %></li>
    </ol>
    <p class="muted small"><%= t('kiosk.full') %></p>
  </section>
</div>

<%- include('partials/foot') %>
