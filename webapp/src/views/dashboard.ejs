<%- include('partials/head') %>

<section class="hero">
  <p class="eyebrow">Program evaluation</p>
  <h1>Analytics &amp; operations</h1>
  <p class="lead">De-identified aggregates only — no names, tokens, or client identifiers leave this view.</p>
</section>

<section class="stats">
  <article class="stat"><span class="stat-value"><%= summary.clients %></span><span class="stat-label">clients enrolled</span></article>
  <article class="stat"><span class="stat-value"><%= summary.active_sessions %></span><span class="stat-label">on the floor</span></article>
  <article class="stat"><span class="stat-value"><%= summary.queued %></span><span class="stat-label">in the queue</span></article>
  <article class="stat"><span class="stat-value"><%= Number(summary.pounds_distributed).toFixed(1) %></span><span class="stat-label">lb distributed</span></article>
  <article class="stat"><span class="stat-value"><%= summary.restricted_in_carts %></span><span class="stat-label">restricted units caught</span></article>
  <article class="stat"><span class="stat-value"><%= summary.expiring_lots %></span><span class="stat-label">lots expiring ≤ 7d</span></article>
</section>

<% if (flash) { %><div class="banner" role="status"><%= flash %></div><% } %>

<section class="card" id="floor">
  <div class="card-head">
    <h2>Floor &amp; waiting line</h2>
    <span class="pill"><%= floor.active %> / <%= floor.max %> on the floor · <%= floor.queued %> waiting</span>
  </div>
  <div class="grid grid--two">
    <div>
      <form method="post" action="/dashboard/floor/capacity" class="stack">
        <label for="max_floor_capacity">Max shoppers on the floor</label>
        <div class="input-row">
          <input id="max_floor_capacity" name="max_floor_capacity" type="number" min="1" max="500" value="<%= floor.max %>" required>
          <button type="submit" class="btn btn--primary">Save</button>
        </div>
        <p class="muted small">Tip for demos: set this to 1, check in two clients, and the second joins the line. Raising it admits people right away.</p>
      </form>
      <form method="post" action="/dashboard/floor/sweep">
        <button type="submit" class="btn btn--ghost btn--sm">Release inactive sessions now</button>
      </form>
    </div>
    <div>
      <table class="table">
        <thead><tr><th>#</th><th>Household</th><th>Waiting</th></tr></thead>
        <tbody>
          <% queue.forEach(function (row) { %>
            <tr><td><%= row.position %></td><td><%= row.household_size %> people</td><td><%= row.waiting_min %> min</td></tr>
          <% }) %>
          <% if (!queue.length) { %><tr><td colspan="3" class="muted">Nobody is waiting.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="card">
  <div class="card-head">
    <h2>Clinical outcome trends</h2>
    <a class="btn btn--ghost btn--sm" href="/dashboard/export/outcomes.csv">Export CSV</a>
  </div>
  <p class="muted small">
    De-identified cohort averages at program markers (baseline, 3 months, 6 months after each client's first reading).
    A household with several conditions counts in each of its condition groups.
  </p>
  <table class="table">
    <thead><tr><th>Condition</th><th>Marker</th><th>Clients</th><th>Baseline</th><th>3 mo</th><th>6 mo</th><th>Change</th></tr></thead>
    <tbody>
      <% outcomes.forEach(function (row) { %>
        <% var latest = row.delta6 !== null ? row.delta6 : row.delta3; %>
        <tr>
          <td><%= row.condition.replace('_', ' ') %></td>
          <td><%= row.marker %></td>
          <td><%= row.clients %></td>
          <td><%= row.baseline %></td>
          <td><%= row.month3 === null ? '—' : row.month3 %></td>
          <td><%= row.month6 === null ? '—' : row.month6 %></td>
          <td>
            <% if (latest === null) { %>—<% } else { %>
              <% var badge = { improving: 'approved', worsening: 'restricted', flat: 'capped' }[row.trend]; %>
              <span class="badge badge--<%= badge %>">
                <%= latest > 0 ? '+' : '' %><%= latest %> · <%= row.trend %>
              </span>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!outcomes.length) { %><tr><td colspan="7" class="muted">No biometric readings yet.</td></tr><% } %>
    </tbody>
  </table>
</section>

<div class="grid grid--two">
  <section class="card">
    <div class="card-head">
      <h2>Distribution by category</h2>
      <a class="btn btn--ghost btn--sm" href="/dashboard/export/conditions.csv">Export by condition</a>
    </div>
    <table class="table">
      <thead><tr><th>Month</th><th>Category</th><th>Status</th><th>Units</th><th>Weight (lb)</th></tr></thead>
      <tbody>
        <% distribution.forEach(function (row) { %>
          <tr>
            <td><%= new Date(row.month).toISOString().slice(0, 7) %></td>
            <td><%= row.category %></td>
            <td><span class="badge badge--<%= row.evaluated_status %>"><%= row.evaluated_status %></span></td>
            <td><%= row.units %></td>
            <td><%= Number(row.weight_lbs).toFixed(1) %></td>
          </tr>
        <% }) %>
        <% if (!distribution.length) { %><tr><td colspan="5" class="muted">No checkouts yet.</td></tr><% } %>
      </tbody>
    </table>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>Funder attribution</h2>
      <a class="btn btn--ghost btn--sm" href="/dashboard/export/grants.csv">Export grant ledger</a>
    </div>
    <table class="table">
      <thead><tr><th>Funder</th><th>Pounds distributed</th></tr></thead>
      <tbody>
        <% grants.forEach(function (row) { %>
          <tr><td><%= row.funder %></td><td><%= Number(row.pounds).toFixed(1) %></td></tr>
        <% }) %>
        <% if (!grants.length) { %><tr><td colspan="2" class="muted">No grant-linked checkouts yet.</td></tr><% } %>
      </tbody>
    </table>
  </section>
</div>

<section class="card">
  <h2>Restock route (aisle-sequenced)</h2>
  <table class="table">
    <thead><tr><th>Aisle</th><th>Shelf</th><th>Bin</th><th>Item</th><th>On hand</th><th>Min</th></tr></thead>
    <tbody>
      <% replenishment.forEach(function (row) { %>
        <tr>
          <td><%= row.aisle %></td><td><%= row.shelf %></td><td><%= row.bin %></td>
          <td><%= row.name %></td><td><%= row.on_hand %></td><td><%= row.min_threshold %></td>
        </tr>
      <% }) %>
      <% if (!replenishment.length) { %><tr><td colspan="6" class="muted">All bins above threshold.</td></tr><% } %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>FIFO expiry watch (≤ 7 days)</h2>
  <table class="table">
    <thead><tr><th>Expires</th><th>Days left</th><th>Item</th><th>Lot</th><th>Remaining</th></tr></thead>
    <tbody>
      <% expiring.forEach(function (row) { %>
        <tr>
          <td><%= new Date(row.expires_on).toISOString().slice(0, 10) %></td>
          <td><%= row.days_left %></td>
          <td><%= row.name %></td>
          <td><code><%= row.lot_code %></code></td>
          <td><%= row.quantity_remaining %></td>
        </tr>
      <% }) %>
      <% if (!expiring.length) { %><tr><td colspan="5" class="muted">No lots expiring this week.</td></tr><% } %>
    </tbody>
  </table>
</section>

<%- include('partials/foot') %>
