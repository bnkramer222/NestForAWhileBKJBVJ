<%- include('partials/head') %>

<section class="hero">
  <p class="eyebrow"><%= t('done.eyebrow') %></p>
  <h1><%= t('done.h1', { name: name }) %></h1>
  <p class="lead"><%= t('done.lead') %></p>
</section>

<div class="grid grid--two">
  <section class="card card--elevated">
    <h2><%= t('done.card') %></h2>
    <img src="<%= tokenQr %>" alt="QR <%= token %>" width="180" height="180" class="card-qr">
    <p class="token"><%= token %></p>
    <p class="muted small"><%= t('done.scanHint') %></p>
    <a class="btn btn--primary" href="/kiosk?code=<%= encodeURIComponent(token) %>"><%= t('done.start') %></a>
  </section>

  <section class="card">
    <h2><%= t('done.plan') %></h2>
    <p><strong><%= plan.label %></strong></p>
    <p class="muted small"><%= plan.notes %></p>
    <ul class="summary-list">
      <li><%= t('done.household') %>: <strong><%= householdSize %></strong></li>
      <li><%= t('done.conditions') %>: <strong><%= conditionNames.length ? conditionNames.join('; ') : t('done.none') %></strong></li>
      <li><%= t('done.allergies') %>: <strong><%= allergies.length ? allergies.join(', ') : t('done.none') %></strong></li>
    </ul>
    <p class="muted small"><%= t('done.auto') %></p>
  </section>
</div>

<p class="muted small"><a href="/enroll"><%= t('done.another') %></a></p>

<%- include('partials/foot') %>
